# Cloudflare Worker secrets — DO NOT COMMIT actual values.
# Generate with:  tether pskgen  (for tokens, generate a random 32-byte base64 value)
#
# Deploy with:
#   cd worker
#   npx wrangler secret put TOKEN_PC
#   npx wrangler secret put TOKEN_MAC
#
# Then store the same values locally:
#   tether keystore set api-token <TOKEN_PC>   (on PC)
#   tether keystore set api-token <TOKEN_MAC>  (on Mac)

TOKEN_PC=REPLACE_WITH_32_BYTE_BASE64_SECRET
TOKEN_MAC=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_SECRET
